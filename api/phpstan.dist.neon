parameters:
    level: 8
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        - '#Property App\\Entity\\.*::\$id \(int\|null\) is never assigned int#'
        - 
            # Ignoré car sinon on doit préciser les types de toutes les valeurs dans les array
            message: '`no value type specified in iterable type array`'
